; COMMAND-LINE: --solve-int-as-bag
; EXPECT: sat
(set-logic ALL)
(set-info :status sat)
(set-option :incremental false)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(declare-fun x3 () Int)
(declare-fun x4 () Int)
(declare-fun x5 () Int)
(declare-fun x6 () Int)
(declare-fun x7 () Int)
(declare-fun x8 () Int)
(assert (distinct x0 x1 x2 x3 x4 x5 x6 x7 x8))
(assert (same.factors x0 x1))
(assert (same.factors x1 x2))
(assert (same.factors x2 x3))
(assert (same.factors x3 x4))
(assert (same.factors x4 x5))
(assert (same.factors x5 x6))
(assert (same.factors x6 x7))
(assert (same.factors x7 x8))
(check-sat)
